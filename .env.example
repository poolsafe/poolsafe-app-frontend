# Variáveis de ambiente do PoolSafe Frontend
#
# Copie este arquivo para .env e preencha os valores no ambiente local.
# Nunca commite o arquivo .env com valores reais.
#
# Variáveis prefixadas com EXPO_PUBLIC_ são expostas ao bundle
# do aplicativo — não use esse prefixo para segredos.

# URL base da API Node.js (sem barra final, incluindo prefixo de versão /api/v1)
#
# Opção 1 — Emulador Android acessando a máquina local:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000/api/v1
#
# Opção 2 — Aparelho físico na mesma rede local/Wi-Fi do computador de desenvolvimento:
# EXPO_PUBLIC_API_BASE_URL=http://<IP_DO_COMPUTADOR>:3012/api/v1
#
# Opção 3 — Produção / Release acessando a API remota publicada via HTTPS:
EXPO_PUBLIC_API_BASE_URL=https://api.poolsafe.app/api/v1
